NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Auth (Managed Better Auth) — server-only.
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Data API — server-only. User-scoped queries/RPCs go through this URL
# with the caller's own JWT; RLS enforces row visibility.
NEON_DATA_API_URL=

# Direct Postgres connections — server-only. Never used to serve a
# user-facing request (that would bypass RLS); only Drizzle Kit,
# server-only setup scripts, and SQL security tests use these.
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Neon API/project identifiers — server-only, used by setup scripts/CI to
# guard against pointing a migration or test run at the wrong project or
# branch.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# E2E test credentials — never real values in Git, local shell/CI secrets only.
E2E_EMPLOYEE_EMAIL=
E2E_EMPLOYEE_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
